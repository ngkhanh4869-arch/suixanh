{
  "entities": {
    "order": {
      "title": "Order",
      "description": "Customer order with recipient details, line items, and delivery status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order ID", "maxLength": 64 },
        "userId": { "type": "string", "description": "Authenticated user UID if signed in", "maxLength": 128 },
        "customerName": { "type": "string", "description": "Full name of the customer", "maxLength": 100 },
        "phone": { "type": "string", "description": "Customer contact phone", "maxLength": 20 },
        "email": { "type": "string", "description": "Customer email", "maxLength": 100 },
        "address": { "type": "string", "description": "Delivery address", "maxLength": 300 },
        "note": { "type": "string", "description": "Delivery note", "maxLength": 500 },
        "items": { "type": "array", "description": "List of ordered products and quantities" },
        "totalAmount": { "type": "number", "description": "Total amount in VND" },
        "paymentMethod": { "type": "string", "description": "Selected payment method", "enum": ["cod", "bank_transfer", "vietqr"] },
        "status": { "type": "string", "description": "Fulfillment status", "enum": ["pending", "preparing", "shipping", "delivered", "cancelled"] },
        "estimatedDeliveryDays": { "type": "string", "description": "Estimated shipping duration (e.g. 3-5 ngày)", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "Order creation timestamp", "maxLength": 64 },
        "updatedAt": { "type": "string", "description": "Last update timestamp", "maxLength": 64 }
      },
      "required": ["id", "customerName", "phone", "address", "items", "totalAmount", "status", "createdAt"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Registered customer or member account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID", "maxLength": 128 },
        "email": { "type": "string", "description": "Google email address", "maxLength": 100 },
        "displayName": { "type": "string", "description": "User display name", "maxLength": 120 },
        "photoURL": { "type": "string", "description": "Avatar URL", "maxLength": 500 },
        "createdAt": { "type": "string", "description": "Registration date timestamp ISO", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "description": "Last authentication timestamp ISO", "maxLength": 64 }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "admin": {
      "title": "Admin",
      "description": "Admin identity and permission record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin Auth UID", "maxLength": 128 },
        "email": { "type": "string", "description": "Admin email", "maxLength": 100 },
        "displayName": { "type": "string", "description": "Admin display name", "maxLength": 120 },
        "role": { "type": "string", "description": "User role", "enum": ["admin", "superadmin"] },
        "assignedBy": { "type": "string", "description": "Email of the super admin who appointed this role", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "Appointment timestamp ISO", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Customer orders collection"
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Registered user accounts collection for members"
    },
    "/admins/{adminUid}": {
      "schema": "admin",
      "description": "Administrators and Super Admin collection"
    }
  }
}
