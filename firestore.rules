rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Super Admin: ngkhanh4869@gmail.com with verified Google auth token
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'ngkhanh4869@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Admins: either Super Admin or users appointed by Super Admin in /admins/{uid}
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phone', 'address', 'items', 'totalAmount', 'status', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
        data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
        data.address is string && data.address.size() > 0 && data.address.size() <= 300 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.status is string && data.status in ['pending', 'preparing', 'shipping', 'delivered', 'returned', 'cancelled'] &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod in ['cod', 'bank_transfer', 'vietqr'])) &&
        (!('estimatedDeliveryDays' in data) || (data.estimatedDeliveryDays is string && data.estimatedDeliveryDays.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
        data.role is string && data.role in ['admin', 'superadmin'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('assignedBy' in data) || (data.assignedBy is string && data.assignedBy.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /orders/{orderId} {
      // Single order lookup allows customer tracking by exact orderId, or admin
      allow get: if isValidId(orderId);
      // List of all orders requires admin (both regular admins and super admin)
      allow list: if isAdmin();
      // Public customer checkout create
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      // Admin update for order status & shipping info
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming());
      // Admin deletion if necessary
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /users/{userId} {
      // Profile owner or admin can read single profile (PII protection)
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      // Only admin can list all registered users
      allow list: if isAdmin();
      // User can create or update their own profile upon login
      allow create, update: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming());
      // Admin can delete user if needed
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminUid} {
      // All admins can view other admins
      allow get: if isValidId(adminUid) && isAdmin();
      allow list: if isAdmin();
      // ONLY the Super Admin can appoint or update admins
      allow create, update: if isValidId(adminUid) && isSuperAdmin() && isValidAdmin(incoming());
      // ONLY the Super Admin can revoke (delete) admin privileges
      allow delete: if isValidId(adminUid) && isSuperAdmin();
    }
  }
}
